{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "jsx-a11y", "unicorn", "oxc", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["dist", "release", "coverage", "reports", ".stryker-tmp", "test-results", "playwright-report"],
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-console": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/core has no interface code. Keep React in src/ outside core."
              },
              {
                "name": "react-dom",
                "message": "src/core has no interface code. Keep React in src/ outside core."
              },
              {
                "name": "electron",
                "message": "src/core has no Electron. Reach the system through PlatformBridge."
              }
            ],
            "patterns": [
              {
                "group": ["react/*", "react-dom/*", "electron/*"],
                "message": "src/core imports nothing from React or Electron."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**", "src/core/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Randomness comes from the level seed. Use createRandom(seed) from the activity kit."
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "setTimeout",
            "message": "Use kit.scope.setTimeout so leaving the activity cancels it."
          },
          {
            "name": "setInterval",
            "message": "Use kit.scope.setInterval so leaving the activity cancels it."
          },
          {
            "name": "requestAnimationFrame",
            "message": "Use kit.scope.requestFrame so leaving the activity cancels it."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Randomness comes from the level seed. Use createRandom(seed) from the activity kit."
          },
          {
            "object": "window",
            "property": "setTimeout",
            "message": "Use kit.scope.setTimeout."
          },
          {
            "object": "window",
            "property": "setInterval",
            "message": "Use kit.scope.setInterval."
          },
          {
            "object": "window",
            "property": "requestAnimationFrame",
            "message": "Use kit.scope.requestFrame."
          },
          {
            "object": "globalThis",
            "property": "setTimeout",
            "message": "Use kit.scope.setTimeout."
          },
          {
            "object": "globalThis",
            "property": "setInterval",
            "message": "Use kit.scope.setInterval."
          },
          {
            "object": "globalThis",
            "property": "requestAnimationFrame",
            "message": "Use kit.scope.requestFrame."
          }
        ]
      }
    },
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "rules": {
        "react/jsx-no-literals": "off"
      }
    },
    {
      "files": ["electron/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "importNames": ["autoUpdater", "crashReporter"],
                "message": "Hard rule 1: the app has no auto-update and no crash reporting."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tools/**", "electron/main/**", "e2e/**", "*.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["electron/preload/index.ts"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    }
  ]
}
