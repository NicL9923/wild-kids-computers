{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  // Tools import the paint engine to build glyph tables, fixtures, and benchmarks, and share the
  // string and clip-naming code with the app. Vitest tasks import the registries, which need
  // Vite's types, so tsconfig.test.json checks them instead.
  "include": [
    "electron/main",
    "tools",
    "vite.config.ts",
    "src/core/platform",
    "src/core/bands.ts",
    "src/core/paint",
    "src/core/strings"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/testing/**", "tools/tasks/*.task.ts"]
}
