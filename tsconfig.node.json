{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  // Tools import the paint engine to build glyph tables, fixtures, and benchmarks.
  "include": ["electron/main", "tools", "vite.config.ts", "src/core/platform", "src/core/bands.ts", "src/core/paint"],
  "exclude": ["src/**/*.test.ts", "src/**/testing/**"]
}
