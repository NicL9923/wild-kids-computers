{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  // Tools share the string and clip-naming code with the app. Vitest tasks import the registries,
  // which need Vite's types, so tsconfig.test.json checks them instead.
  "include": ["electron/main", "tools", "src/core/strings", "vite.config.ts"],
  "exclude": ["tools/tasks/*.task.ts"]
}
