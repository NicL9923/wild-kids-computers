# Keep LF in the repository on every platform.
* text=auto eol=lf

# Binary assets. Git must never normalize or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.ogg binary
*.opus binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
